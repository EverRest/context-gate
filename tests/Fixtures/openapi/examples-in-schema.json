{
    "openapi": "3.1.0",
    "info": {"title": "Examples in schema fixture", "version": "1.0.0"},
    "paths": {
        "/users/{id}": {
            "get": {
                "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
                "responses": {
                    "200": {
                        "description": "A user",
                        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "id": {"type": "integer"},
                    "name": {"type": "string"},
                    "email": {"type": "string", "format": "email"},
                    "token": {"type": "string"}
                },
                "required": ["id", "name"],
                "example": {
                    "id": 1,
                    "name": "Fixture Person",
                    "email": "canary-fixture@example.invalid",
                    "token": "FAKE_FIXTURE_ONLY_TOKEN_0001"
                }
            }
        }
    }
}
